PORT=3000
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# For DeepSeek, use: https://api.deepseek.com/v1
# For local models, use: http://localhost:11434/v1

# TTS (Text-to-Speech) Configuration - Alibaba Cloud Bailian
# Get your API key from: https://bailian.console.aliyun.com/
# Note: qwen3-tts-flash requires DashScope Python SDK (dashscope.MultiModalConversation.call())
TTS_API_KEY=your_bailian_api_key_here
TTS_API_URL=https://dashscope.aliyuncs.com/api/v1
TTS_MODEL=qwen3-tts-flash
TTS_TIMEOUT_MS=30000
TTS_MAX_CHUNK_LENGTH=500